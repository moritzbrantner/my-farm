{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FarmView",
  "type": "object",
  "required": [
    "barn_capacity",
    "barn_tile",
    "barn_upgrade_tier",
    "barn_used",
    "coins",
    "delivery_board_built",
    "delivery_board_tile",
    "delivery_orders",
    "field_plots",
    "inventory",
    "last_update_ms",
    "level",
    "machines",
    "oven",
    "owned_farmhouse_upgrades",
    "resident_task_queues",
    "residents",
    "selected_resident_id",
    "shelters",
    "silo_capacity",
    "silo_tile",
    "silo_upgrade_tier",
    "silo_used",
    "unlocks",
    "xp"
  ],
  "properties": {
    "barn_capacity": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "barn_tile": {
      "$ref": "#/definitions/Tile"
    },
    "barn_upgrade_tier": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "barn_used": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "coins": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "delivery_board_built": {
      "type": "boolean"
    },
    "delivery_board_tile": {
      "$ref": "#/definitions/Tile"
    },
    "delivery_orders": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/DeliveryOrder"
      }
    },
    "field_plots": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/FieldPlot"
      }
    },
    "inventory": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/InventoryItemView"
      }
    },
    "last_update_ms": {
      "type": "integer",
      "format": "int64"
    },
    "level": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "machines": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/MachineState"
      }
    },
    "oven": {
      "$ref": "#/definitions/OvenState"
    },
    "owned_farmhouse_upgrades": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/FarmhouseUpgradeKind"
      }
    },
    "resident_task_queues": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/definitions/ResidentTask"
        }
      }
    },
    "residents": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/FarmResident"
      }
    },
    "selected_resident_id": {
      "type": "string"
    },
    "shelters": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/AnimalShelterState"
      }
    },
    "silo_capacity": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "silo_tile": {
      "$ref": "#/definitions/Tile"
    },
    "silo_upgrade_tier": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "silo_used": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "unlocks": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/UnlockView"
      }
    },
    "xp": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    }
  },
  "definitions": {
    "AnimalShelterState": {
      "type": "object",
      "required": [
        "animals",
        "id",
        "kind",
        "tile"
      ],
      "properties": {
        "animals": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AnimalSlot"
          }
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/ShelterKind"
        },
        "tile": {
          "$ref": "#/definitions/Tile"
        }
      }
    },
    "AnimalSlot": {
      "type": "object",
      "required": [
        "id",
        "state"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "state": {
          "$ref": "#/definitions/AnimalState"
        }
      }
    },
    "AnimalState": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "idle"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "fed_at_ms",
            "ready_at_ms",
            "type"
          ],
          "properties": {
            "fed_at_ms": {
              "type": "integer",
              "format": "int64"
            },
            "ready_at_ms": {
              "type": "integer",
              "format": "int64"
            },
            "type": {
              "type": "string",
              "enum": [
                "producing"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ready"
              ]
            }
          }
        }
      ]
    },
    "DeliveryOrder": {
      "type": "object",
      "required": [
        "id",
        "requirements",
        "reward_coins",
        "reward_xp"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ItemStack"
          }
        },
        "reward_coins": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "reward_xp": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "FarmResident": {
      "type": "object",
      "required": [
        "display_name",
        "id"
      ],
      "properties": {
        "display_name": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      }
    },
    "FarmhouseUpgradeKind": {
      "type": "string",
      "enum": [
        "oven"
      ]
    },
    "FieldPlot": {
      "type": "object",
      "required": [
        "id",
        "tile"
      ],
      "properties": {
        "crop": {
          "anyOf": [
            {
              "$ref": "#/definitions/PlantedCrop"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "tile": {
          "$ref": "#/definitions/Tile"
        }
      }
    },
    "InventoryItemView": {
      "type": "object",
      "required": [
        "item_id",
        "kind",
        "name",
        "quantity"
      ],
      "properties": {
        "item_id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/ItemKind"
        },
        "name": {
          "type": "string"
        },
        "quantity": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "ItemKind": {
      "type": "string",
      "enum": [
        "crop",
        "feed",
        "animal_product",
        "product"
      ]
    },
    "ItemStack": {
      "type": "object",
      "required": [
        "item_id",
        "quantity"
      ],
      "properties": {
        "item_id": {
          "type": "string"
        },
        "quantity": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "MachineJob": {
      "type": "object",
      "required": [
        "id",
        "ready_at_ms",
        "recipe_id",
        "started_at_ms"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "ready_at_ms": {
          "type": "integer",
          "format": "int64"
        },
        "recipe_id": {
          "type": "string"
        },
        "started_at_ms": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "MachineKind": {
      "type": "string",
      "enum": [
        "bakery",
        "feed_mill"
      ]
    },
    "MachineState": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "queue",
        "tile"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/MachineKind"
        },
        "queue": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MachineJob"
          }
        },
        "tile": {
          "$ref": "#/definitions/Tile"
        }
      }
    },
    "OvenState": {
      "type": "object",
      "required": [
        "id",
        "queue"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "queue": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MachineJob"
          }
        }
      }
    },
    "PlantedCrop": {
      "type": "object",
      "required": [
        "item_id",
        "planted_at_ms",
        "ready_at_ms"
      ],
      "properties": {
        "item_id": {
          "type": "string"
        },
        "planted_at_ms": {
          "type": "integer",
          "format": "int64"
        },
        "ready_at_ms": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "ReservedWorkTarget": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "plot_id",
            "type"
          ],
          "properties": {
            "plot_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "field_plot"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "machine_id",
            "type"
          ],
          "properties": {
            "machine_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "machine"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "oven"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "animal_slot",
            "shelter_id",
            "type"
          ],
          "properties": {
            "animal_slot": {
              "type": "string"
            },
            "shelter_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "animal"
              ]
            }
          }
        }
      ]
    },
    "ResidentTask": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "ready_at_ms",
        "started_at_ms",
        "steps"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/ResidentTaskKind"
        },
        "ready_at_ms": {
          "type": "integer",
          "format": "int64"
        },
        "started_at_ms": {
          "type": "integer",
          "format": "int64"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ResidentTaskStep"
          }
        }
      }
    },
    "ResidentTaskKind": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "field_work"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "production_work"
              ]
            }
          }
        }
      ]
    },
    "ResidentTaskStep": {
      "type": "object",
      "required": [
        "reserved_work_target",
        "work"
      ],
      "properties": {
        "reserved_work_target": {
          "$ref": "#/definitions/ReservedWorkTarget"
        },
        "work": {
          "$ref": "#/definitions/ResidentTaskStepWork"
        }
      }
    },
    "ResidentTaskStepWork": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "crop_id",
            "type"
          ],
          "properties": {
            "crop_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "plant_crop"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "crop_id",
            "quantity",
            "type"
          ],
          "properties": {
            "crop_id": {
              "type": "string"
            },
            "quantity": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            },
            "type": {
              "type": "string",
              "enum": [
                "harvest_crop"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "job_id",
            "recipe_id",
            "type"
          ],
          "properties": {
            "job_id": {
              "type": "string"
            },
            "recipe_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "collect_machine_job"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "job_id",
            "recipe_id",
            "type"
          ],
          "properties": {
            "job_id": {
              "type": "string"
            },
            "recipe_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "collect_oven_job"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "feed_animal"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "item_id",
            "quantity",
            "type"
          ],
          "properties": {
            "item_id": {
              "type": "string"
            },
            "quantity": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            },
            "type": {
              "type": "string",
              "enum": [
                "collect_animal_product"
              ]
            }
          }
        }
      ]
    },
    "ShelterKind": {
      "type": "string",
      "enum": [
        "chicken_coop",
        "cow_pasture"
      ]
    },
    "Tile": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "format": "int32"
        },
        "y": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "UnlockView": {
      "type": "object",
      "required": [
        "label",
        "level",
        "unlocked"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "level": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "unlocked": {
          "type": "boolean"
        }
      }
    }
  }
}
