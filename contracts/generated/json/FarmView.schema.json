{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FarmView",
  "type": "object",
  "properties": {
    "barn_capacity": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "barn_tile": {
      "$ref": "#/$defs/Tile"
    },
    "barn_upgrade_tier": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "barn_used": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "coins": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "delivery_board_built": {
      "type": "boolean"
    },
    "delivery_board_tile": {
      "$ref": "#/$defs/Tile"
    },
    "delivery_orders": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DeliveryOrder"
      }
    },
    "farm_shop": {
      "anyOf": [
        {
          "$ref": "#/$defs/FarmShopView"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "field_plots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FieldPlot"
      }
    },
    "house_interior": {
      "$ref": "#/$defs/HouseInterior"
    },
    "inventory": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/InventoryItemView"
      }
    },
    "last_update_ms": {
      "type": "integer",
      "format": "int64"
    },
    "level": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "machines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MachineState"
      }
    },
    "oven": {
      "$ref": "#/$defs/OvenState"
    },
    "owned_farmhouse_upgrades": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FarmhouseUpgradeKind"
      }
    },
    "reservations": {
      "$ref": "#/$defs/ReservationView"
    },
    "resident_cleanup_blocks": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/ResidentCleanupBlock"
      },
      "default": null
    },
    "resident_locations": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Tile"
      }
    },
    "resident_work": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ResidentWorkView"
      }
    },
    "residents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FarmResident"
      }
    },
    "selected_resident_id": {
      "type": "string"
    },
    "shelters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AnimalShelterState"
      }
    },
    "silo_capacity": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "silo_tile": {
      "$ref": "#/$defs/Tile"
    },
    "silo_upgrade_tier": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "silo_used": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "tool_shed": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolShedState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "unlocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/UnlockView"
      }
    },
    "xp": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "last_update_ms",
    "xp",
    "level",
    "coins",
    "silo_used",
    "silo_capacity",
    "silo_upgrade_tier",
    "silo_tile",
    "barn_used",
    "barn_capacity",
    "barn_upgrade_tier",
    "barn_tile",
    "inventory",
    "field_plots",
    "machines",
    "owned_farmhouse_upgrades",
    "oven",
    "shelters",
    "delivery_board_built",
    "delivery_board_tile",
    "delivery_orders",
    "residents",
    "selected_resident_id",
    "resident_locations",
    "resident_work",
    "reservations",
    "house_interior",
    "unlocks"
  ],
  "$defs": {
    "AnimalReservationKey": {
      "type": "object",
      "properties": {
        "animal_slot": {
          "type": "string"
        },
        "shelter_id": {
          "type": "string"
        }
      },
      "required": [
        "shelter_id",
        "animal_slot"
      ]
    },
    "AnimalShelterState": {
      "type": "object",
      "properties": {
        "animals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AnimalSlot"
          }
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ShelterKind"
        },
        "tile": {
          "$ref": "#/$defs/Tile"
        }
      },
      "required": [
        "id",
        "kind",
        "tile",
        "animals"
      ]
    },
    "AnimalSlot": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/AnimalState"
        }
      },
      "required": [
        "id",
        "state"
      ]
    },
    "AnimalState": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "idle"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "producing"
            },
            "fed_at_ms": {
              "type": "integer",
              "format": "int64"
            },
            "ready_at_ms": {
              "type": "integer",
              "format": "int64"
            }
          },
          "required": [
            "type",
            "fed_at_ms",
            "ready_at_ms"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "ready"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "BlockedResidentTaskView": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "resident_id": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "resident_id",
        "reason",
        "message"
      ]
    },
    "DecorationPlacement": {
      "type": "object",
      "properties": {
        "decoration_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "tile": {
          "$ref": "#/$defs/RoomTile"
        }
      },
      "required": [
        "id",
        "decoration_id",
        "tile"
      ]
    },
    "DeliveryOrder": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ItemStack"
          }
        },
        "reward_coins": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "reward_xp": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "requirements",
        "reward_coins",
        "reward_xp"
      ]
    },
    "FarmResident": {
      "type": "object",
      "properties": {
        "display_name": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "display_name"
      ]
    },
    "FarmShopPriceView": {
      "type": "object",
      "properties": {
        "base_price": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "item_id": {
          "type": "string"
        },
        "max_price": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "price": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "sale_chance_bps": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "item_id",
        "price",
        "base_price",
        "max_price",
        "sale_chance_bps"
      ]
    },
    "FarmShopRejectionWindow": {
      "type": "object",
      "properties": {
        "base_price": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "id": {
          "type": "string"
        },
        "item_id": {
          "type": "string"
        },
        "sale_chance_bps": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "shop_price": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "visible_until_ms": {
          "type": "integer",
          "format": "int64"
        },
        "visited_at_ms": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "id",
        "item_id",
        "shop_price",
        "base_price",
        "sale_chance_bps",
        "visited_at_ms",
        "visible_until_ms"
      ]
    },
    "FarmShopSaleWindow": {
      "type": "object",
      "properties": {
        "coins_gained": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "id": {
          "type": "string"
        },
        "item_id": {
          "type": "string"
        },
        "quantity": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "sold_at_ms": {
          "type": "integer",
          "format": "int64"
        },
        "visible_until_ms": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "id",
        "item_id",
        "quantity",
        "coins_gained",
        "sold_at_ms",
        "visible_until_ms"
      ]
    },
    "FarmShopView": {
      "type": "object",
      "properties": {
        "current_rejection": {
          "anyOf": [
            {
              "$ref": "#/$defs/FarmShopRejectionWindow"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "current_sale": {
          "anyOf": [
            {
              "$ref": "#/$defs/FarmShopSaleWindow"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "type": "string"
        },
        "item_type_capacity": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "next_customer_visit_at_ms": {
          "type": "integer",
          "format": "int64"
        },
        "prices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FarmShopPriceView"
          }
        },
        "stock": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InventoryItemView"
          }
        },
        "stock_capacity": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "tile": {
          "$ref": "#/$defs/Tile"
        },
        "visit_count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "tile",
        "stock",
        "stock_capacity",
        "item_type_capacity",
        "prices",
        "next_customer_visit_at_ms",
        "visit_count"
      ]
    },
    "FarmhouseUpgradeKind": {
      "type": "string",
      "enum": [
        "oven"
      ]
    },
    "FieldPlot": {
      "type": "object",
      "properties": {
        "crop": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlantedCrop"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "tile": {
          "$ref": "#/$defs/Tile"
        }
      },
      "required": [
        "id",
        "tile"
      ]
    },
    "HouseInterior": {
      "type": "object",
      "properties": {
        "rooms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Room"
          }
        }
      },
      "required": [
        "rooms"
      ]
    },
    "InventoryItemView": {
      "type": "object",
      "properties": {
        "available_quantity": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "default": null,
          "minimum": 0
        },
        "item_id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ItemKind"
        },
        "name": {
          "type": "string"
        },
        "quantity": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "reserved_quantity": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "default": null,
          "minimum": 0
        }
      },
      "required": [
        "item_id",
        "name",
        "quantity",
        "kind"
      ]
    },
    "ItemKind": {
      "type": "string",
      "enum": [
        "crop",
        "feed",
        "animal_product",
        "product"
      ]
    },
    "ItemStack": {
      "type": "object",
      "properties": {
        "item_id": {
          "type": "string"
        },
        "quantity": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "item_id",
        "quantity"
      ]
    },
    "MachineJob": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "ready_at_ms": {
          "type": "integer",
          "format": "int64"
        },
        "recipe_id": {
          "type": "string"
        },
        "started_at_ms": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "id",
        "recipe_id",
        "started_at_ms",
        "ready_at_ms"
      ]
    },
    "MachineKind": {
      "type": "string",
      "enum": [
        "feed_mill"
      ]
    },
    "MachineState": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/MachineKind"
        },
        "queue": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MachineJob"
          }
        },
        "tile": {
          "$ref": "#/$defs/Tile"
        }
      },
      "required": [
        "id",
        "kind",
        "tile",
        "queue"
      ]
    },
    "OvenJob": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "ready_at_ms": {
          "type": "integer",
          "format": "int64"
        },
        "recipe_id": {
          "type": "string"
        },
        "started_at_ms": {
          "type": "integer",
          "format": "int64"
        },
        "status": {
          "$ref": "#/$defs/OvenJobStatus",
          "default": "producing"
        }
      },
      "required": [
        "id",
        "recipe_id",
        "started_at_ms",
        "ready_at_ms"
      ]
    },
    "OvenJobStatus": {
      "type": "string",
      "enum": [
        "pending_start",
        "producing"
      ]
    },
    "OvenState": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "queue": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OvenJob"
          }
        }
      },
      "required": [
        "id",
        "queue"
      ]
    },
    "PlantedCrop": {
      "type": "object",
      "properties": {
        "item_id": {
          "type": "string"
        },
        "planted_at_ms": {
          "type": "integer",
          "format": "int64"
        },
        "ready_at_ms": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "item_id",
        "planted_at_ms",
        "ready_at_ms"
      ]
    },
    "ReservationReasonView": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "resident_id": {
          "type": "string"
        },
        "resident_name": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        }
      },
      "required": [
        "resident_id",
        "resident_name",
        "task_id",
        "reason"
      ]
    },
    "ReservationView": {
      "type": "object",
      "properties": {
        "animals": {
          "type": "array",
          "items": {
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "$ref": "#/$defs/AnimalReservationKey"
              },
              {
                "$ref": "#/$defs/ReservationReasonView"
              }
            ]
          }
        },
        "farm_shop_stock": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          },
          "default": {}
        },
        "field_plots": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ReservationReasonView"
          }
        },
        "machines": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ReservationReasonView"
          }
        },
        "oven": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReservationReasonView"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "path_tiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReservedPathTileView"
          }
        }
      },
      "required": [
        "field_plots",
        "machines",
        "animals",
        "path_tiles"
      ]
    },
    "ReservedPathTileView": {
      "type": "object",
      "properties": {
        "resident_id": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "tile": {
          "$ref": "#/$defs/Tile"
        }
      },
      "required": [
        "tile",
        "resident_id",
        "task_id"
      ]
    },
    "ResidentCarryItemView": {
      "type": "object",
      "properties": {
        "item_id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ItemKind"
        },
        "name": {
          "type": "string"
        },
        "quantity": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "item_id",
        "name",
        "quantity",
        "kind"
      ]
    },
    "ResidentCarryToolView": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "quantity": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "tool_kind": {
          "$ref": "#/$defs/ToolKind"
        }
      },
      "required": [
        "tool_kind",
        "label",
        "quantity"
      ]
    },
    "ResidentCarryView": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResidentCarryItemView"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResidentCarryToolView"
          }
        }
      },
      "required": [
        "items",
        "tools"
      ]
    },
    "ResidentCleanupBlock": {
      "type": "object",
      "properties": {
        "destination": {
          "$ref": "#/$defs/StorageSourceRef"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ItemStack"
          }
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "reason",
        "destination",
        "items"
      ]
    },
    "ResidentPathState": {
      "type": "string",
      "enum": [
        "walking",
        "working"
      ]
    },
    "ResidentScenePoint": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "x",
        "y"
      ]
    },
    "ResidentSceneView": {
      "type": "object",
      "properties": {
        "inside_house": {
          "type": "boolean"
        },
        "path": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResidentScenePoint"
          }
        },
        "path_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResidentPathState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tile": {
          "$ref": "#/$defs/ResidentScenePoint"
        }
      },
      "required": [
        "tile",
        "path",
        "inside_house"
      ]
    },
    "ResidentStepView": {
      "type": "object",
      "properties": {
        "activity": {
          "$ref": "#/$defs/ResidentVisualActivity"
        },
        "duration_ms": {
          "type": "integer",
          "format": "int64"
        },
        "kind": {
          "$ref": "#/$defs/ItemKind"
        },
        "label": {
          "type": "string"
