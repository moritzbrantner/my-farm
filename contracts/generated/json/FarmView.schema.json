  "definitions": {
    "AnimalReservationKey": {
      "type": "object",
      "required": [
        "animal_slot",
        "shelter_id"
      ],
      "properties": {
        "animal_slot": {
          "type": "string"
        },
        "shelter_id": {
          "type": "string"
        }
      }
    },
    "AnimalShelterState": {
      "type": "object",
      "required": [
        "animals",
        "id",
        "kind",
        "tile"
      ],
      "properties": {
        "animals": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AnimalSlot"
          }
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/ShelterKind"
        },
        "tile": {
          "$ref": "#/definitions/Tile"
        }
      }
    },
    "AnimalSlot": {
      "type": "object",
      "required": [
        "id",
        "state"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "state": {
          "$ref": "#/definitions/AnimalState"
        }
      }
    },
    "AnimalState": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "idle"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "fed_at_ms",
            "ready_at_ms",
            "type"
          ],
          "properties": {
            "fed_at_ms": {
              "type": "integer",
              "format": "int64"
            },
            "ready_at_ms": {
              "type": "integer",
              "format": "int64"
            },
            "type": {
              "type": "string",
              "enum": [
                "producing"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ready"
              ]
            }
          }
        }
      ]
    },
    "BlockedResidentTaskView": {
      "type": "object",
      "required": [
        "message",
        "reason",
        "resident_id",
        "task_id"
      ],
      "properties": {
        "message": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "resident_id": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        }
      }
    },
    "DecorationPlacement": {
      "type": "object",
      "required": [
        "decoration_id",
        "id",
        "tile"
      ],
      "properties": {
        "decoration_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "tile": {
          "$ref": "#/definitions/RoomTile"
        }
      }
    },
    "DeliveryOrder": {
      "type": "object",
      "required": [
        "id",
        "requirements",
        "reward_coins",
        "reward_xp"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ItemStack"
          }
        },
        "reward_coins": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "reward_xp": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "FarmResident": {
      "type": "object",
      "required": [
        "display_name",
        "id"
      ],
      "properties": {
        "display_name": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      }
    },
    "FarmShopPriceView": {
      "type": "object",
      "required": [
        "base_price",
        "item_id",
        "max_price",
        "price",
        "sale_chance_bps"
      ],
      "properties": {
        "base_price": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "item_id": {
          "type": "string"
        },
        "max_price": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "price": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "sale_chance_bps": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "FarmShopRejectionWindow": {
      "type": "object",
      "required": [
        "base_price",
        "id",
        "item_id",
        "sale_chance_bps",
        "shop_price",
        "visible_until_ms",
        "visited_at_ms"
      ],
      "properties": {
        "base_price": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "id": {
          "type": "string"
        },
        "item_id": {
          "type": "string"
        },
        "sale_chance_bps": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "shop_price": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "visible_until_ms": {
          "type": "integer",
          "format": "int64"
        },
        "visited_at_ms": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "FarmShopSaleWindow": {
      "type": "object",
      "required": [
        "coins_gained",
        "id",
        "item_id",
        "quantity",
        "sold_at_ms",
        "visible_until_ms"
      ],
      "properties": {
        "coins_gained": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "id": {
          "type": "string"
        },
        "item_id": {
          "type": "string"
        },
        "quantity": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "sold_at_ms": {
          "type": "integer",
          "format": "int64"
        },
        "visible_until_ms": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "FarmShopView": {
      "type": "object",
      "required": [
        "id",
        "item_type_capacity",
        "next_customer_visit_at_ms",
        "prices",
        "stock",
        "stock_capacity",
        "tile",
        "visit_count"
      ],
      "properties": {
        "current_rejection": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/FarmShopRejectionWindow"
            },
            {
              "type": "null"
            }
          ]
        },
        "current_sale": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/FarmShopSaleWindow"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "item_type_capacity": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "next_customer_visit_at_ms": {
          "type": "integer",
          "format": "int64"
        },
        "prices": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FarmShopPriceView"
          }
        },
        "stock": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/InventoryItemView"
          }
        },
        "stock_capacity": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "tile": {
          "$ref": "#/definitions/Tile"
        },
        "visit_count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      }
    },
    "FarmhouseUpgradeKind": {
      "type": "string",
      "enum": [
        "oven"
      ]
    },
    "FieldPlot": {
      "type": "object",
      "required": [
        "id",
        "tile"
      ],
      "properties": {
        "crop": {
          "anyOf": [
            {
              "$ref": "#/definitions/PlantedCrop"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "tile": {
          "$ref": "#/definitions/Tile"
        }
      }
    },
    "HouseInterior": {
      "type": "object",
      "required": [
        "rooms"
      ],
      "properties": {
        "rooms": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Room"
          }
        }
      }
    },
    "InventoryItemView": {
      "type": "object",
      "required": [
        "item_id",
        "kind",
        "name",
        "quantity"
      ],
      "properties": {
        "available_quantity": {
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "item_id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/ItemKind"
        },
        "name": {
          "type": "string"
        },
        "quantity": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "reserved_quantity": {
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "ItemKind": {
      "type": "string",
      "enum": [
        "crop",
        "feed",
        "animal_product",
        "product"
      ]
    },
    "ItemStack": {
      "type": "object",
      "required": [
        "item_id",
        "quantity"
      ],
      "properties": {
        "item_id": {
          "type": "string"
        },
        "quantity": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "MachineJob": {
      "type": "object",
      "required": [
        "id",
        "ready_at_ms",
        "recipe_id",
        "started_at_ms"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "ready_at_ms": {
          "type": "integer",
          "format": "int64"
        },
        "recipe_id": {
          "type": "string"
        },
        "started_at_ms": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "MachineKind": {
      "type": "string",
      "enum": [
        "feed_mill"
      ]
    },
    "MachineState": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "queue",
        "tile"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/MachineKind"
        },
        "queue": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MachineJob"
          }
        },
        "tile": {
          "$ref": "#/definitions/Tile"
        }
      }
    },
    "OvenJob": {
      "type": "object",
      "required": [
        "id",
        "ready_at_ms",
        "recipe_id",
        "started_at_ms"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "ready_at_ms": {
          "type": "integer",
          "format": "int64"
        },
        "recipe_id": {
          "type": "string"
        },
        "started_at_ms": {
          "type": "integer",
          "format": "int64"
        },
        "status": {
          "default": "producing",
          "allOf": [
            {
              "$ref": "#/definitions/OvenJobStatus"
            }
          ]
        }
      }
    },
    "OvenJobStatus": {
      "type": "string",
      "enum": [
        "pending_start",
        "producing"
      ]
    },
    "OvenState": {
      "type": "object",
      "required": [
        "id",
        "queue"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "queue": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/OvenJob"
          }
        }
      }
    },
    "PlantedCrop": {
      "type": "object",
      "required": [
        "item_id",
        "planted_at_ms",
        "ready_at_ms"
      ],
      "properties": {
        "item_id": {
          "type": "string"
        },
        "planted_at_ms": {
          "type": "integer",
          "format": "int64"
        },
        "ready_at_ms": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "ReservationReasonView": {
      "type": "object",
      "required": [
        "reason",
        "resident_id",
        "resident_name",
        "task_id"
      ],
      "properties": {
        "reason": {
          "type": "string"
        },
        "resident_id": {
          "type": "string"
        },
        "resident_name": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        }
      }
    },
    "ReservationView": {
      "type": "object",
      "required": [
        "animals",
        "field_plots",
        "machines",
        "path_tiles"
      ],
      "properties": {
        "animals": {
          "type": "array",
          "items": {
            "type": "array",
            "items": [
              {
                "$ref": "#/definitions/AnimalReservationKey"
              },
              {
                "$ref": "#/definitions/ReservationReasonView"
              }
            ],
            "maxItems": 2,
            "minItems": 2
          }
        },
        "farm_shop_stock": {
          "default": {},
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0.0
          }
        },
        "field_plots": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/ReservationReasonView"
          }
        },
        "machines": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/ReservationReasonView"
          }
        },
        "oven": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/ReservationReasonView"
            },
            {
              "type": "null"
            }
          ]
        },
        "path_tiles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReservedPathTileView"
          }
        }
      }
    },
    "ReservedPathTileView": {
      "type": "object",
      "required": [
        "resident_id",
        "task_id",
        "tile"
      ],
      "properties": {
        "resident_id": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "tile": {
          "$ref": "#/definitions/Tile"
        }
      }
    },
    "ResidentCarryItemView": {
      "type": "object",
      "required": [
        "item_id",
        "kind",
        "name",
        "quantity"
      ],
      "properties": {
        "item_id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/ItemKind"
        },
        "name": {
          "type": "string"
        },
        "quantity": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "ResidentCarryToolView": {
      "type": "object",
      "required": [
        "label",
        "quantity",
        "tool_kind"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "quantity": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "tool_kind": {
          "$ref": "#/definitions/ToolKind"
        }
      }
    },
    "ResidentCarryView": {
      "type": "object",
      "required": [
        "items",
        "tools"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ResidentCarryItemView"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ResidentCarryToolView"
          }
        }
      }
    },
    "ResidentCleanupBlock": {
      "type": "object",
      "required": [
        "destination",
        "items",
        "reason"
      ],
      "properties": {
        "destination": {
          "$ref": "#/definitions/StorageSourceRef"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ItemStack"
          }
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "ResidentPathState": {
      "type": "string",
      "enum": [
        "walking",
        "working"
      ]
    },
    "ResidentScenePoint": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        }
      }
    },
    "ResidentSceneView": {
      "type": "object",
      "required": [
        "inside_house",
        "path",
        "tile"
      ],
      "properties": {
        "inside_house": {
          "type": "boolean"
        },
        "path": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ResidentScenePoint"
          }
        },
        "path_state": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/ResidentPathState"
            },
            {
              "type": "null"
            }
          ]
        },
        "tile": {
          "$ref": "#/definitions/ResidentScenePoint"
        }
      }
    },
    "ResidentStepView": {
      "type": "object",
      "required": [
        "activity",
