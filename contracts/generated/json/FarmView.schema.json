{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FarmView",
  "type": "object",
  "required": [
    "barn_capacity",
    "barn_tile",
    "barn_upgrade_tier",
    "barn_used",
    "coins",
    "delivery_board_built",
    "delivery_board_tile",
    "delivery_orders",
    "field_plots",
    "house_interior",
    "inventory",
    "last_update_ms",
    "level",
    "machines",
    "oven",
    "owned_farmhouse_upgrades",
    "reservations",
    "resident_locations",
    "resident_work",
    "residents",
    "selected_resident_id",
    "shelters",
    "silo_capacity",
    "silo_tile",
    "silo_upgrade_tier",
    "silo_used",
    "unlocks",
    "xp"
  ],
  "properties": {
    "barn_capacity": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "barn_tile": {
      "$ref": "#/definitions/Tile"
    },
    "barn_upgrade_tier": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "barn_used": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "coins": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "delivery_board_built": {
      "type": "boolean"
    },
    "delivery_board_tile": {
      "$ref": "#/definitions/Tile"
    },
    "delivery_orders": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/DeliveryOrder"
      }
    },
    "farm_shop": {
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/FarmShopView"
        },
        {
          "type": "null"
        }
      ]
    },
    "field_plots": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/FieldPlot"
      }
    },
    "house_interior": {
      "$ref": "#/definitions/HouseInterior"
    },
    "inventory": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/InventoryItemView"
      }
    },
    "last_update_ms": {
      "type": "integer",
      "format": "int64"
    },
    "level": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "machines": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/MachineState"
      }
    },
    "oven": {
      "$ref": "#/definitions/OvenState"
    },
    "owned_farmhouse_upgrades": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/FarmhouseUpgradeKind"
      }
    },
    "reservations": {
      "$ref": "#/definitions/ReservationView"
    },
    "resident_cleanup_blocks": {
      "default": null,
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "$ref": "#/definitions/ResidentCleanupBlock"
      }
    },
    "resident_locations": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/Tile"
      }
    },
    "resident_work": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/ResidentWorkView"
      }
    },
    "residents": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/FarmResident"
      }
    },
    "selected_resident_id": {
      "type": "string"
    },
    "shelters": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/AnimalShelterState"
      }
    },
    "silo_capacity": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "silo_tile": {
      "$ref": "#/definitions/Tile"
    },
    "silo_upgrade_tier": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "silo_used": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "tool_shed": {
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/ToolShedState"
        },
        {
          "type": "null"
        }
      ]
    },
    "unlocks": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/UnlockView"
      }
    },
    "xp": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    }
