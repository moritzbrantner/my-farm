        "type": {
          "type": "string",
          "const": "collect_animal_product"
        },
        "animal_slot": {
          "type": "string"
        },
        "shelter_id": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "shelter_id",
        "animal_slot"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "fulfill_delivery_order"
        },
