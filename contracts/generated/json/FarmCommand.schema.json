        "crop_id": {
          "type": "string"
        },
        "plot_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "crop_id",
        "plot_ids"
      ]
    },
    {
      "type": "object",
