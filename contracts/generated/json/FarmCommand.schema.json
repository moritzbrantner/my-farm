        "type": {
          "type": "string",
          "const": "plant_crop"
        },
        "crop_id": {
          "type": "string"
        },
        "plot_id": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "plot_id",
        "crop_id"
      ]
