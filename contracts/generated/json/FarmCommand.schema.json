      "required": [
        "type",
        "plot_id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "sweep_harvest"
        },
        "harvest_mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/SweepHarvestMode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
