        "type",
        "tile"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "move_structure"
        },
        "target": {
          "$ref": "#/$defs/StructureTarget"
        },
        "tile": {
          "$ref": "#/$defs/Tile"
        }
      },
      "required": [
        "type",
        "target",
        "tile"
      ]
