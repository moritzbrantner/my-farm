  "$defs": {
    "FarmhouseUpgradeKind": {
      "type": "string",
      "enum": [
        "oven"
      ]
    },
    "RoomTile": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "x",
        "y"
      ]
    },
    "StorageKind": {
      "type": "string",
      "enum": [
        "silo",
        "barn"
      ]
    },
    "StructureKind": {
      "type": "string",
      "enum": [
        "silo",
        "barn",
        "feed_mill",
        "chicken_coop",
        "cow_pasture",
        "delivery_board",
        "tool_shed",
        "farm_shop"
      ]
    },
    "StructureTarget": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "silo"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "barn"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "machine"
            },
            "id": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "shelter"
            },
            "id": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "delivery_board"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "tool_shed"
            },
            "id": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "farm_shop"
            },
            "id": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "id"
          ]
        }
      ]
    },
    "SweepHarvestMode": {
      "type": "string",
      "enum": [
        "matching_crop",
        "all_crops"
      ]
    },
    "Tile": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "format": "int32"
        },
        "y": {
          "type": "integer",
          "format": "int32"
        }
      },
      "required": [
        "x",
        "y"
      ]
    }
  }
}
