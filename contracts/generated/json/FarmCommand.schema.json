        "room_id": {
          "type": "string"
        },
        "tile": {
          "$ref": "#/$defs/RoomTile"
        }
      },
      "required": [
        "type",
        "room_id",
        "decoration_id",
        "tile"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "move_decoration"
        },
