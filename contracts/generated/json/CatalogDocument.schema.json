{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CatalogDocument",
  "type": "object",
  "required": [
    "balance",
    "crops",
    "decorations",
    "farmhouse_upgrades",
    "items",
    "level_xp",
    "machines",
    "market_items",
    "recipes",
    "shelters",
    "storage_upgrades"
  ],
  "properties": {
    "balance": {
      "$ref": "#/definitions/BalanceConfig"
    },
    "crops": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/CropDef"
      }
    },
    "decorations": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/DecorationDef"
      }
    },
    "farmhouse_upgrades": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/FarmhouseUpgradeDef"
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ItemDef"
      }
    },
    "level_xp": {
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint32",
        "minimum": 0.0
      }
    },
    "machines": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/MachineDef"
      }
    },
    "market_items": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/MarketItemDef"
      }
    },
    "recipes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/RecipeDef"
      }
    },
    "shelters": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ShelterDef"
      }
    },
    "storage_upgrades": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/StorageUpgradeDef"
      }
    }
  },
  "definitions": {
    "BalanceConfig": {
      "type": "object",
      "required": [
        "max_orders",
        "time_scale"
      ],
      "properties": {
        "max_orders": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "time_scale": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "CropDef": {
      "type": "object",
      "required": [
        "harvest_quantity",
        "item_id",
        "reference_seconds",
        "unlock_level",
        "xp"
      ],
      "properties": {
        "harvest_quantity": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "item_id": {
          "type": "string"
        },
        "reference_seconds": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "unlock_level": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "xp": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "DecorationDef": {
      "type": "object",
      "required": [
        "footprint",
        "id",
        "name"
      ],
      "properties": {
        "footprint": {
          "$ref": "#/definitions/DecorationFootprint"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "DecorationFootprint": {
      "type": "object",
      "required": [
        "height",
        "width"
      ],
      "properties": {
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "FarmhouseUpgradeDef": {
      "type": "object",
      "required": [
        "cost_coins",
        "kind",
        "name",
        "queue_limit",
        "unlock_level"
      ],
      "properties": {
        "cost_coins": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "kind": {
          "$ref": "#/definitions/FarmhouseUpgradeKind"
        },
        "name": {
          "type": "string"
        },
        "queue_limit": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "unlock_level": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "FarmhouseUpgradeKind": {
      "type": "string",
      "enum": [
        "oven"
      ]
    },
    "ItemDef": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name",
        "unlock_level"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/ItemKind"
        },
        "name": {
          "type": "string"
        },
        "unlock_level": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "ItemKind": {
      "type": "string",
      "enum": [
        "crop",
        "feed",
        "animal_product",
        "product"
      ]
    },
    "ItemStack": {
      "type": "object",
      "required": [
        "item_id",
        "quantity"
      ],
      "properties": {
        "item_id": {
          "type": "string"
        },
        "quantity": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "MachineDef": {
      "type": "object",
      "required": [
        "build_cost",
        "kind",
        "name",
        "queue_limit",
        "unlock_level"
      ],
      "properties": {
        "build_cost": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "kind": {
          "$ref": "#/definitions/MachineKind"
        },
        "name": {
          "type": "string"
        },
        "queue_limit": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "unlock_level": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "MachineKind": {
      "type": "string",
      "enum": [
        "feed_mill"
      ]
    },
    "MarketItemDef": {
      "type": "object",
      "required": [
        "item_id",
        "unlock_level"
      ],
      "properties": {
        "buy_price": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "item_id": {
          "type": "string"
        },
        "sell_price": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "unlock_level": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "RecipeDef": {
      "type": "object",
      "required": [
        "id",
        "inputs",
        "name",
        "outputs",
        "reference_seconds",
        "target",
        "unlock_level",
        "xp"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ItemStack"
          }
        },
        "name": {
          "type": "string"
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ItemStack"
          }
        },
        "reference_seconds": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "target": {
          "$ref": "#/definitions/RecipeTarget"
        },
        "unlock_level": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "xp": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "RecipeTarget": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "oven"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "machine_kind",
            "type"
          ],
          "properties": {
            "machine_kind": {
              "$ref": "#/definitions/MachineKind"
            },
            "type": {
              "type": "string",
              "enum": [
                "machine"
              ]
            }
          }
        }
      ]
    },
    "ShelterDef": {
      "type": "object",
      "required": [
        "animal_name",
        "build_cost",
        "feed_item_id",
        "kind",
        "name",
        "product_item_id",
        "reference_seconds",
        "slots",
        "unlock_level",
        "xp"
      ],
      "properties": {
        "animal_name": {
          "type": "string"
        },
        "build_cost": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "feed_item_id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/ShelterKind"
        },
        "name": {
          "type": "string"
        },
        "product_item_id": {
          "type": "string"
        },
        "reference_seconds": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "slots": {
          "type": "integer",
          "format": "uint",
          "minimum": 0.0
        },
        "unlock_level": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "xp": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "ShelterKind": {
      "type": "string",
      "enum": [
        "chicken_coop",
        "cow_pasture"
      ]
    },
    "StorageKind": {
      "type": "string",
      "enum": [
        "silo",
        "barn"
      ]
    },
    "StorageUpgradeDef": {
      "type": "object",
      "required": [
        "capacity",
        "cost_coins",
        "storage_kind",
        "tier",
        "unlock_level"
      ],
      "properties": {
        "capacity": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "cost_coins": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "storage_kind": {
          "$ref": "#/definitions/StorageKind"
        },
        "tier": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "unlock_level": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    }
  }
}
