{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CatalogResponse",
  "type": "object",
  "properties": {
    "catalog": {
      "$ref": "#/$defs/CatalogDocument"
    }
  },
  "required": [
    "catalog"
  ],
  "$defs": {
    "BalanceConfig": {
      "type": "object",
      "properties": {
        "max_orders": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "time_scale": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "time_scale",
        "max_orders"
      ]
    },
    "CatalogDocument": {
      "type": "object",
      "properties": {
        "balance": {
          "$ref": "#/$defs/BalanceConfig"
        },
        "crops": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CropDef"
          }
        },
        "decorations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DecorationDef"
          }
        },
        "farmhouse_upgrades": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FarmhouseUpgradeDef"
          }
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ItemDef"
          }
        },
        "level_xp": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "machines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MachineDef"
          }
        },
        "market_items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MarketItemDef"
          }
        },
        "recipes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RecipeDef"
          }
        },
        "shelters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ShelterDef"
          }
        },
        "storage_upgrades": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StorageUpgradeDef"
          }
        }
      },
      "required": [
        "balance",
        "items",
        "crops",
        "recipes",
        "machines",
        "farmhouse_upgrades",
        "shelters",
        "market_items",
        "storage_upgrades",
        "decorations",
        "level_xp"
      ]
    },
    "CropDef": {
      "type": "object",
      "properties": {
        "harvest_quantity": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "item_id": {
          "type": "string"
        },
        "reference_seconds": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "unlock_level": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "xp": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "item_id",
        "reference_seconds",
        "harvest_quantity",
        "xp",
        "unlock_level"
      ]
    },
    "DecorationDef": {
      "type": "object",
      "properties": {
        "footprint": {
          "$ref": "#/$defs/DecorationFootprint"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "footprint"
      ]
    },
    "DecorationFootprint": {
      "type": "object",
      "properties": {
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "width",
        "height"
      ]
    },
    "FarmhouseUpgradeDef": {
      "type": "object",
      "properties": {
        "cost_coins": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "kind": {
          "$ref": "#/$defs/FarmhouseUpgradeKind"
        },
        "name": {
          "type": "string"
        },
        "queue_limit": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "unlock_level": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "name",
        "cost_coins",
        "unlock_level",
        "queue_limit"
      ]
    },
    "FarmhouseUpgradeKind": {
      "type": "string",
      "enum": [
        "oven"
      ]
    },
    "ItemDef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ItemKind"
        },
        "name": {
          "type": "string"
        },
        "unlock_level": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "unlock_level"
      ]
    },
    "ItemKind": {
      "type": "string",
      "enum": [
        "crop",
        "feed",
        "animal_product",
        "product"
      ]
    },
    "ItemStack": {
      "type": "object",
      "properties": {
        "item_id": {
          "type": "string"
        },
        "quantity": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "item_id",
        "quantity"
      ]
    },
    "MachineDef": {
      "type": "object",
      "properties": {
        "build_cost": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "kind": {
          "$ref": "#/$defs/MachineKind"
        },
        "name": {
          "type": "string"
        },
        "queue_limit": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "unlock_level": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "name",
        "build_cost",
        "unlock_level",
        "queue_limit"
      ]
    },
    "MachineKind": {
      "type": "string",
      "enum": [
        "feed_mill"
      ]
    },
    "MarketItemDef": {
      "type": "object",
      "properties": {
        "buy_price": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "item_id": {
          "type": "string"
        },
        "sell_price": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "unlock_level": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "item_id",
        "unlock_level"
      ]
    },
    "RecipeDef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ItemStack"
          }
        },
        "name": {
          "type": "string"
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ItemStack"
          }
        },
        "reference_seconds": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "target": {
          "$ref": "#/$defs/RecipeTarget"
        },
        "unlock_level": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "xp": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "name",
        "target",
        "inputs",
        "outputs",
        "reference_seconds",
        "xp",
        "unlock_level"
      ]
    },
    "RecipeTarget": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "oven"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "machine"
            },
            "machine_kind": {
              "$ref": "#/$defs/MachineKind"
            }
          },
          "required": [
            "type",
            "machine_kind"
          ]
        }
      ]
    },
    "ShelterDef": {
      "type": "object",
      "properties": {
        "animal_name": {
          "type": "string"
        },
        "build_cost": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "feed_item_id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ShelterKind"
        },
        "name": {
          "type": "string"
        },
        "product_item_id": {
          "type": "string"
        },
        "reference_seconds": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "slots": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "unlock_level": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "xp": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "name",
        "animal_name",
        "build_cost",
        "unlock_level",
        "slots",
        "feed_item_id",
        "product_item_id",
        "reference_seconds",
        "xp"
      ]
    },
    "ShelterKind": {
      "type": "string",
      "enum": [
        "chicken_coop",
        "cow_pasture"
      ]
    },
    "StorageKind": {
      "type": "string",
      "enum": [
        "silo",
        "barn"
      ]
    },
    "StorageUpgradeDef": {
      "type": "object",
      "properties": {
        "capacity": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "cost_coins": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "storage_kind": {
          "$ref": "#/$defs/StorageKind"
        },
        "tier": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "unlock_level": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "storage_kind",
        "tier",
        "unlock_level",
        "cost_coins",
        "capacity"
      ]
    }
  }
}
