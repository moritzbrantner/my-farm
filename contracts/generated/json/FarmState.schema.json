          "$ref": "#/$defs/AnimalState"
        }
      },
      "required": [
        "id",
        "state"
      ]
    },
    "AnimalState": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "idle"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "producing"
            },
            "fed_at_ms": {
              "type": "integer",
              "format": "int64"
            },
            "ready_at_ms": {
              "type": "integer",
              "format": "int64"
            }
          },
          "required": [
            "type",
            "fed_at_ms",
            "ready_at_ms"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "ready"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "BlockedResidentTask": {
