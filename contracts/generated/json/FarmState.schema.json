{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FarmState",
  "type": "object",
  "required": [
    "barn_capacity",
    "coins",
    "delivery_board_built",
    "delivery_orders",
    "field_plots",
    "inventory",
    "last_update_ms",
    "level",
    "machines",
    "next_id",
    "shelters",
    "silo_capacity",
    "xp"
  ],
  "properties": {
    "barn_capacity": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "barn_tile": {
      "default": {
        "x": 16,
        "y": 2
      },
      "allOf": [
        {
          "$ref": "#/definitions/Tile"
        }
      ]
    },
    "barn_upgrade_tier": {
      "default": 0,
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "claimed_crop_unlocks": {
      "default": [
        "wheat",
        "corn"
      ],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coins": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "delivery_board_built": {
      "type": "boolean"
    },
    "delivery_board_tile": {
      "default": {
        "x": 2,
        "y": 7
      },
      "allOf": [
        {
          "$ref": "#/definitions/Tile"
        }
      ]
    },
    "delivery_orders": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/DeliveryOrder"
      }
    },
    "field_plots": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/FieldPlot"
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "format": "uint32",
        "minimum": 0.0
      }
    },
    "last_update_ms": {
      "type": "integer",
      "format": "int64"
    },
    "level": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "machines": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/MachineState"
      }
    },
    "next_id": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "shelters": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/AnimalShelterState"
      }
    },
    "silo_capacity": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "silo_tile": {
      "default": {
        "x": 14,
        "y": 2
      },
      "allOf": [
        {
          "$ref": "#/definitions/Tile"
        }
      ]
    },
    "silo_upgrade_tier": {
      "default": 0,
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "xp": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    }
  },
  "definitions": {
    "AnimalShelterState": {
      "type": "object",
      "required": [
        "animals",
        "id",
        "kind",
        "tile"
      ],
      "properties": {
        "animals": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AnimalSlot"
          }
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/ShelterKind"
        },
        "tile": {
          "$ref": "#/definitions/Tile"
        }
      }
    },
    "AnimalSlot": {
      "type": "object",
      "required": [
        "id",
        "state"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "state": {
          "$ref": "#/definitions/AnimalState"
        }
      }
    },
    "AnimalState": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "idle"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "fed_at_ms",
            "ready_at_ms",
            "type"
          ],
          "properties": {
            "fed_at_ms": {
              "type": "integer",
              "format": "int64"
            },
            "ready_at_ms": {
              "type": "integer",
              "format": "int64"
            },
            "type": {
              "type": "string",
              "enum": [
                "producing"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "ready"
              ]
            }
          }
        }
      ]
    },
    "DeliveryOrder": {
      "type": "object",
      "required": [
        "id",
        "requirements",
        "reward_coins",
        "reward_xp"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ItemStack"
          }
        },
        "reward_coins": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "reward_xp": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "FieldPlot": {
      "type": "object",
      "required": [
        "id",
        "tile"
      ],
      "properties": {
        "crop": {
          "anyOf": [
            {
              "$ref": "#/definitions/PlantedCrop"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "tile": {
          "$ref": "#/definitions/Tile"
        }
      }
    },
    "ItemStack": {
      "type": "object",
      "required": [
        "item_id",
        "quantity"
      ],
      "properties": {
        "item_id": {
          "type": "string"
        },
        "quantity": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "MachineJob": {
      "type": "object",
      "required": [
        "id",
        "ready_at_ms",
        "recipe_id",
        "started_at_ms"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "ready_at_ms": {
          "type": "integer",
          "format": "int64"
        },
        "recipe_id": {
          "type": "string"
        },
        "started_at_ms": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "MachineKind": {
      "type": "string",
      "enum": [
        "bakery",
        "feed_mill"
      ]
    },
    "MachineState": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "queue",
        "tile"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/MachineKind"
        },
        "queue": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MachineJob"
          }
        },
        "tile": {
          "$ref": "#/definitions/Tile"
        }
      }
    },
    "PlantedCrop": {
      "type": "object",
      "required": [
        "item_id",
        "planted_at_ms",
        "ready_at_ms"
      ],
      "properties": {
        "item_id": {
          "type": "string"
        },
        "planted_at_ms": {
          "type": "integer",
          "format": "int64"
        },
        "ready_at_ms": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "ShelterKind": {
      "type": "string",
      "enum": [
        "chicken_coop",
        "cow_pasture"
      ]
    },
    "Tile": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "format": "int32"
        },
        "y": {
          "type": "integer",
          "format": "int32"
        }
      }
    }
  }
}
