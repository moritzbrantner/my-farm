{
  "name": "my-farm-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cd ../.. && bun run build:wasm-demo && cd apps/web && vite --port 5176",
    "build": "cd ../.. && bun run build:wasm-demo && cd apps/web && bun run build:prepared",
    "preview": "vite preview --port 4174",
    "storybook": "storybook dev -p 6006 --no-open",
    "build:storybook": "storybook build",
    "test:geometry": "bun run scripts/check-gable-roof-geometry.ts",
    "test:e2e": "playwright test",
    "test:e2e:pages-demo": "playwright test -c playwright.pages-demo.config.ts",
    "test:storybook": "NODE_BIN=\"$(dirname \"$(command -v npm)\")/node\"; \"$NODE_BIN\" ./node_modules/vitest/vitest.mjs --project=storybook --run",
    "build:prepared": "node ../../scripts/verify-farm-art.mjs && tsc --noEmit && vite build"
  },
  "dependencies": {
    "@my-farm/contracts": "workspace:*",
    "@my-farm/game-client": "workspace:*",
    "@my-farm/game-scene": "workspace:*",
    "@my-farm/game-model": "workspace:*",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.8.2",
    "@vitejs/plugin-react": "^6.1.2",
    "lucide-react": "^1.23.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/builder-vite": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitest/browser-playwright": "5.0.5",
    "storybook": "10.6.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
