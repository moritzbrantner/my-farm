{
  "name": "my-farm-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cd ../.. && bun run build:wasm-demo && cd apps/web && vite --port 5176",
    "build": "cd ../.. && bun run build:wasm-demo && cd apps/web && bun run build:prepared",
    "preview": "vite preview --port 4174",
    "storybook": "storybook dev -p 6006 --no-open",
    "build:storybook": "storybook build",
    "test:geometry": "bun run scripts/check-gable-roof-geometry.ts",
    "test:e2e": "playwright test",
    "test:e2e:pages-demo": "playwright test -c playwright.pages-demo.config.ts",
    "test:storybook": "NODE_BIN=\"$(dirname \"$(command -v npm)\")/node\"; \"$NODE_BIN\" ./node_modules/vitest/vitest.mjs --project=storybook --run",
    "build:prepared": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "@my-farm/contracts": "workspace:*",
    "@my-farm/game-client": "workspace:*",
    "@my-farm/game-scene": "workspace:*",
    "@my-farm/game-model": "workspace:*",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.17.10",
    "@vitejs/plugin-react": "^4.4.1",
    "lucide-react": "^1.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.165.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-vitest": "^10.4.6",
    "@storybook/builder-vite": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.180.0",
    "@vitest/browser-playwright": "^4.1.10",
    "storybook": "^10.4.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^4.1.10"
  }
}
