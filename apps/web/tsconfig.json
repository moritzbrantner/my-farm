{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@my-farm/contracts": ["../../packages/contracts/src/index.ts"],
      "@my-farm/game-client": ["../../packages/game-client/src/index.ts"],
      "@my-farm/game-model": ["../../packages/game-model/src/index.ts"],
      "@my-farm/game-model/*": ["../../packages/game-model/src/*"]
    },
    "typeRoots": ["./node_modules/@types"],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["src", "tests", "../../contracts/generated/ts", "../../packages"]
}
